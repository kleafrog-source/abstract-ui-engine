    {
      "id": "custom.components.snap-slider-carousel",
      "category": "components",
      "name": "Snap slider carousel",
      "semantic_description": "A horizontally scrolling slider or carousel with scroll snapping, motion-aware navigation controls, and animated pagination dots. Designed for showcases, product rails, and testimonial groups where touch scrolling should feel native and button navigation should remain available.",
      "tags": [
        "carousel",
        "slider",
        "scroll snap",
        "dots",
        "horizontal rail",
        "touch friendly"
      ],
      "payload": "snap-slider-carousel scroll-snap rail",
      "css": ".snap-slider-carousel{display:grid;gap:1rem;}.snap-slider-carousel .track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(16rem,1fr);gap:1rem;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;}.snap-slider-carousel .track::-webkit-scrollbar{display:none;}.snap-slider-carousel .slide{scroll-snap-align:start;}.snap-slider-carousel .dots{display:flex;gap:.45rem;align-items:center;justify-content:center;}.snap-slider-carousel .dot{width:.55rem;height:.55rem;border-radius:999px;background:rgba(15,23,42,.2);transition:transform .2s ease,background-color .2s ease;}.snap-slider-carousel .dot.is-active{background:var(--color-accent,#111827);transform:scale(1.22);}",
      "html": "<section class=\"snap-slider-carousel\" data-carousel><div class=\"track\" data-carousel-track><article class=\"slide\">Slide 1</article><article class=\"slide\">Slide 2</article><article class=\"slide\">Slide 3</article></div><div class=\"dots\" data-carousel-dots><button class=\"dot is-active\" aria-label=\"Slide 1\"></button><button class=\"dot\" aria-label=\"Slide 2\"></button><button class=\"dot\" aria-label=\"Slide 3\"></button></div></section>",
      "js": "document.querySelectorAll('[data-carousel]').forEach((root)=>{const track=root.querySelector('[data-carousel-track]');const dots=[...root.querySelectorAll('.dot')];if(!track||!dots.length)return;const sync=()=>{const width=track.firstElementChild?.getBoundingClientRect().width||1;const gap=parseFloat(getComputedStyle(track).columnGap||getComputedStyle(track).gap||'0');const index=Math.round(track.scrollLeft/(width+gap));dots.forEach((dot,i)=>dot.classList.toggle('is-active',i===index));};track.addEventListener('scroll',()=>window.requestAnimationFrame(sync),{passive:true});dots.forEach((dot,index)=>dot.addEventListener('click',()=>{const target=track.children[index];target?.scrollIntoView({behavior:'smooth',inline:'start',block:'nearest'});}));sync();});",
      "accessibility": {
        "contrastRatio": 4.9,
        "aria": [
          "aria-roledescription=carousel",
          "aria-label=Content slider"
        ],
        "focusVisible": true
      },
      "family": "showcase-system",
      "conflicts": [
        "component:carousel"
      ],
      "meta": {
        "source": "web-strategist RNKyaqB",
        "priority": 5
      }
    },
    {
      "id": "custom.components.burger-drawer-menu",
      "category": "components",
      "name": "Burger drawer menu",
      "semantic_description": "A compact mobile navigation control where the three-line burger icon morphs into a close icon while a side panel slides in over a dimmed backdrop. Built for app shells, responsive marketing pages, and catalog views that need an off-canvas menu without a heavy framework.",
      "tags": [
        "burger",
        "drawer menu",
        "off canvas",
        "mobile nav",
        "overlay",
        "morph icon"
      ],
      "payload": "burger-drawer-menu off-canvas mobile navigation",
      "css": ".burger-drawer-menu .burger{display:inline-grid;gap:4px;padding:0;border:0;background:transparent;}.burger-drawer-menu .burger span{width:22px;height:2px;border-radius:999px;background:currentColor;transition:transform .24s ease,opacity .24s ease;}.burger-drawer-menu.is-open .burger span:nth-child(1){transform:translateY(6px) rotate(45deg);}.burger-drawer-menu.is-open .burger span:nth-child(2){opacity:0;}.burger-drawer-menu.is-open .burger span:nth-child(3){transform:translateY(-6px) rotate(-45deg);}.burger-drawer-menu .backdrop{position:fixed;inset:0;background:rgba(15,23,42,.45);opacity:0;pointer-events:none;transition:opacity .24s ease;}.burger-drawer-menu .panel{position:fixed;top:0;right:0;height:100vh;width:min(24rem,86vw);padding:1.25rem;background:#fff;transform:translateX(100%);transition:transform .28s cubic-bezier(.22,1,.36,1);}.burger-drawer-menu.is-open .backdrop{opacity:1;pointer-events:auto;}.burger-drawer-menu.is-open .panel{transform:translateX(0);}",
      "html": "<nav class=\"burger-drawer-menu\" data-drawer-menu><button class=\"burger\" data-drawer-trigger aria-expanded=\"false\" aria-label=\"Open menu\"><span></span><span></span><span></span></button><div class=\"backdrop\" data-drawer-backdrop></div><aside class=\"panel\"><a href=\"#\">Overview</a><a href=\"#\">Library</a><a href=\"#\">Settings</a></aside></nav>",
      "js": "document.querySelectorAll('[data-drawer-menu]').forEach((root)=>{const trigger=root.querySelector('[data-drawer-trigger]');const backdrop=root.querySelector('[data-drawer-backdrop]');if(!trigger)return;const close=()=>{root.classList.remove('is-open');trigger.setAttribute('aria-expanded','false');};const open=()=>{root.classList.add('is-open');trigger.setAttribute('aria-expanded','true');};trigger.addEventListener('click',()=>root.classList.contains('is-open')?close():open());backdrop?.addEventListener('click',close);document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&root.classList.contains('is-open'))close();});});",
      "accessibility": {
        "contrastRatio": 7.1,
        "aria": [
          "aria-expanded",
          "aria-label=Open menu"
        ],
        "focusVisible": true
      },
      "family": "nav-system",
