    {
      "id": "custom.interactions.progressive-text-reveal",
      "category": "interactions",
      "name": "Progressive text reveal",
      "semantic_description": "A progressive character or token reveal interaction for text-first interfaces. Supports staged output, reading rhythm, and semantic emphasis as letters or words fade in over time. Useful for poetic UI, prompt demos, landing hero copy, and guided narrative blocks.",
      "tags": [
        "typewriter",
        "text reveal",
        "staggered letters",
        "narrative motion",
        "character animation",
        "semantic text"
      ],
      "payload": "progressive-text-reveal staggered copy output",
      "js": "document.querySelectorAll('[data-progressive-text]').forEach((el)=>{const raw=el.textContent||'';const units=raw.split('');el.textContent='';units.forEach((ch,index)=>{const span=document.createElement('span');span.textContent=ch;span.style.opacity='0';span.style.transform='translateY(0.25em)';span.style.transition='opacity .28s ease, transform .28s ease';el.appendChild(span);window.setTimeout(()=>{span.style.opacity='1';span.style.transform='translateY(0)';},index*22);});});",
      "family": "text-lab",
      "conflicts": [],
      "meta": {
        "source": "datapoems.io syntax marker",
        "priority": 5
      }
    },
    {
      "id": "custom.interactions.glyph-mouse-reactive",
      "category": "interactions",
      "name": "Glyph mouse reactive",
      "semantic_description": "A split-text interaction where individual glyphs react to pointer position with local rotation, scale, or offset. Designed for experimental hero typography and expressive headings where letters feel alive but remain readable. Strong fit for showcase pages and interactive headline systems.",
      "tags": [
        "split text",
        "glyph motion",
        "mousemove",
        "reactive letters",
        "interactive typography",
        "hero headline"
      ],
      "payload": "glyph-mouse-reactive split heading letters",
      "js": "document.querySelectorAll('[data-glyph-reactive]').forEach((root)=>{const text=root.textContent||'';root.textContent='';[...text].forEach((char)=>{const span=document.createElement('span');span.textContent=char;span.style.display='inline-block';span.style.transition='transform .18s ease';root.appendChild(span);});const letters=[...root.children];root.addEventListener('mousemove',(event)=>{const box=root.getBoundingClientRect();letters.forEach((letter,index)=>{const rect=letter.getBoundingClientRect();const dx=event.clientX-(rect.left+rect.width/2);const dy=event.clientY-(rect.top+rect.height/2);const rotate=Math.max(-10,Math.min(10,dx*0.12));const lift=Math.max(-8,Math.min(8,-dy*0.08));letter.style.transform=`translateY(${lift}px) rotate(${rotate}deg) scale(${1+(index%3)*0.02})`;});});root.addEventListener('mouseleave',()=>letters.forEach((letter)=>{letter.style.transform='';}));});",
      "family": "text-lab",
      "conflicts": [],
      "meta": {
        "source": "Abstract-Mindfreak bNgyZXV",
        "priority": 5
      }
    },
    {
