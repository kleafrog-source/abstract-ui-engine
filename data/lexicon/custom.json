    {
      "id": "custom.interactions.pointer-starfield-depth",
      "category": "interactions",
      "name": "Pointer starfield depth",
      "semantic_description": "A pointer-reactive depth field made of layered particles or stars moving at different rates to simulate parallax in a 3D scene. Best for hero backdrops, tech showcases, experimental intros, and decorative but controllable ambient canvases.",
      "tags": [
        "starfield",
        "particles",
        "pointer parallax",
        "depth field",
        "3d ambient",
        "hero background"
      ],
      "payload": "pointer-starfield-depth layered particle parallax",
      "js": "document.querySelectorAll('[data-starfield-depth]').forEach((root)=>{const layers=[...root.querySelectorAll('[data-depth-layer]')];root.addEventListener('mousemove',(event)=>{const rect=root.getBoundingClientRect();const x=(event.clientX-rect.left)/rect.width-.5;const y=(event.clientY-rect.top)/rect.height-.5;layers.forEach((layer,index)=>{const depth=Number(layer.getAttribute('data-depth-layer'))||index+1;layer.style.transform=`translate3d(${x*depth*14}px,${y*depth*14}px,0)`;});});root.addEventListener('mouseleave',()=>layers.forEach((layer)=>{layer.style.transform='';}));});",
      "family": "ambient-motion",
      "conflicts": [],
      "meta": {
        "source": "0xdracarys xxmJKGJ",
        "priority": 4
      }
    },
    {
