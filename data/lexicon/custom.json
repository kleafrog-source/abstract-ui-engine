      "payload": "gradient-outline-icon-button premium cta",
      "css": ".gradient-outline-icon-button{position:relative;display:inline-flex;align-items:center;gap:.65rem;padding:.9rem 1.2rem;border-radius:999px;background:rgba(17,24,39,.88);color:#fff;overflow:hidden;transition:transform .24s ease,box-shadow .24s ease;}.gradient-outline-icon-button::before{content:'';position:absolute;inset:0;padding:1.5px;border-radius:inherit;background:linear-gradient(120deg,#7c3aed,#22d3ee,#f59e0b);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;}.gradient-outline-icon-button:hover{transform:translateY(-2px);box-shadow:0 16px 38px rgba(124,58,237,.26);}.gradient-outline-icon-button .icon{transition:transform .24s ease;}.gradient-outline-icon-button:hover .icon{transform:rotate(18deg) translateX(2px);}",
